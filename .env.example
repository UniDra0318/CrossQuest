# CrossQuest Environment Configuration Template
# In production, replace all placeholder values with secure randomly-generated secrets.

# Database Configuration
# Migration & DDL Superuser (Used for running migrations and initial schema setup)
POSTGRES_USER=crossquest_admin
POSTGRES_PASSWORD=crossquest_secret_password
POSTGRES_DB=crossquest_db
ADMIN_DATABASE_URL=postgresql+psycopg2://crossquest_admin:crossquest_secret_password@localhost:5432/crossquest_db

# Runtime Application User (Enforces PostgreSQL Row-Level Security policies per CL-01, CL-05)
POSTGRES_APP_USER=crossquest_app
POSTGRES_APP_PASSWORD=app_secure_password
DATABASE_URL=postgresql+psycopg2://crossquest_app:app_secure_password@localhost:5432/crossquest_db

# Security & Cryptography
ENVIRONMENT=development
SECRET_KEY=supersecretjwtkeyforcrossquestplatformchangeinproduction
CONTEXT_SIGNING_SECRET=crossquest_internal_context_signing_secret_key_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_HOURS=8

# AWS KMS Configuration (Optional / Production)
AWS_REGION=ap-southeast-1
AWS_KMS_KEY_ARN=arn:aws:kms:ap-southeast-1:local:crossquest-master-key

# Pilot Data Paths (Optional)
CROSSQUEST_PILOT_WORKBOOK_PATH=
CROSSQUEST_SAMPLE_WORKBOOK_PATH=

# Frontend
VITE_API_URL=http://localhost:8000
